# Local dev config for the management API.
# Copy to .env and adjust. Conductor workspaces regenerate .env automatically
# via .conductor/run.sh (per-workspace API port + database); these defaults are
# for standalone `make -C server start-api`.
#
# DEV ONLY: every value here is a throwaway local credential. .conductor/run.sh
# sources this file for static config, so it is load-bearing — never put a real
# secret in it. Real environments must supply secrets via the environment.

# Server
GOFF_MGMT_SERVER_PORT=8080
GOFF_MGMT_SERVER_ENABLESWAGGER=true
# Multi-company (multi-tenant) mode. Default false = mono company: a single
# company, created by the super admin on first login, that every user joins.
# Also settable with --server.multicompany.
# GOFF_MGMT_SERVER_MULTICOMPANY=true

# Database
GOFF_MGMT_DB_URL=postgres://goff:goff@localhost:5432/goff_mgmt?sslmode=disable

# OIDC (Keycloak local realm "goff", client "goff-mgmt")
GOFF_MGMT_OIDC_ISSUER=http://goff.local:8081/realms/goff
GOFF_MGMT_OIDC_CLIENTID=goff-mgmt
GOFF_MGMT_OIDC_CLIENTSECRET=goff-mgmt-secret
GOFF_MGMT_OIDC_REDIRECTURL=http://goff.local:8080/auth/callback

# Session JWT (must be >=32 chars in production; this is a dev value)
GOFF_MGMT_AUTH_JWTSECRET=dev-secret-change-me-dev-secret-change-me
GOFF_MGMT_AUTH_COOKIESECURE=false
GOFF_MGMT_AUTH_COOKIEDOMAIN=goff.local
GOFF_MGMT_AUTH_ADMINEMAILS=admin@local.io
GOFF_MGMT_AUTH_POSTLOGINREDIRECT=http://goff.local:5173/
# Login requires email_verified=true; set to accept IdPs that omit the claim.
# GOFF_MGMT_AUTH_ALLOWUNVERIFIEDEMAIL=true

# Logging
GOFF_MGMT_LOG_LEVEL=debug
GOFF_MGMT_LOG_FORMAT=console

# OpenTelemetry (standard OTEL_* vars, read by the SDK). Points at the
# otel-lgtm container from docker-compose; Grafana on http://localhost:3000.
# Unset OTEL_TRACES_EXPORTER / OTEL_METRICS_EXPORTER = nothing exported.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Push metrics every 10s instead of 60s so dashboards move while you click around.
OTEL_METRIC_EXPORT_INTERVAL=10000
