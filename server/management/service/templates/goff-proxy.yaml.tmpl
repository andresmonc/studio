# goff-proxy.yaml generated by GO Feature Flag Studio.
# The relay proxy reads flags from the goff_flags view; give it a read-only role:
#   CREATE ROLE goff_relay LOGIN PASSWORD '<password>';
#   GRANT SELECT ON goff_flags TO goff_relay;
server:
  mode: http
  port: 1031
{{- if not .Served}}
# No flagset with an API key in this company yet.
{{- else}}
flagSets:
{{- end}}
{{- range .Flagsets}}
  # {{comment .TeamName}} / {{comment .Name}}
{{- if not .APIKeys}}
  # skipped: no API key
{{- else}}
  - name: {{quote .ID}}
    pollingInterval: 60000
    apiKeys:
{{- range .APIKeys}}
      - {{quote .}}
{{- end}}
    retrievers:
      - kind: postgresql
        uri: {{quote $.URI}}
        table: goff_flags
{{- end}}
{{- end}}
